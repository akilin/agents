{
    "build": {
        "dockerfile": "Dockerfile"
    },
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/node/.claude"
    },
    "customizations": {
        "vscode": {
            "settings": {
                "chat.permissions.default": "autoApprove"
            }
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "mounts": [
        "source=claude-code-config-${localWorkspaceFolderBasename}-${devcontainerId},target=/home/node/.claude,type=volume",
        "source=gh-config,target=/home/node/.config/gh,type=volume"
    ],
    "name": "agents",
    "waitFor": "postStartCommand"
}
